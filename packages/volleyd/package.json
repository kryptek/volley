{
  "name": "volleyd",
  "version": "0.10.0",
  "private": true,
  "description": "volleyd — durable wave supervisor daemon: wave files, journal, DAG scheduler, authority fence",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "volleyd": "./src/cli.ts" },
  "exports": {
    "./claude/sharing": "./src/claude/sharing.ts",
    "./config-defaults": "./src/config-defaults.ts",
    "./footprint": "./src/footprint.ts",
    "./overlap": "./src/overlap.ts",
    "./overlap-plan": "./src/overlap-plan.ts",
    "./paired-hosts": "./src/paired-hosts.ts",
    "./procs": "./src/procs.ts",
    "./repos": "./src/repos.ts",
    "./roles/sheet": "./src/roles/sheet.ts",
    "./trust": "./src/trust.ts",
    "./wave-file": "./src/wave-file.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:shard": "bun ../../scripts/test-shards.ts run",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "volley-cli": "workspace:*",
    "volley-mcp": "workspace:*",
    "volley-sim": "workspace:*",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "aedes": "^0.51.0",
    "vitest": "^2.1.0"
  }
}
