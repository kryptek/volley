  "bin": { "volley": "./src/cli.ts" },
  "exports": {
    "./auth/coordinator-login": "./src/auth/coordinator-login.ts",
    "./auth/version": "./src/auth/version.ts",
    "./auth/dynsec": "./src/auth/dynsec.ts",
    "./auth/roles": "./src/auth/roles.ts",
    "./auth/config": "./src/auth/config.ts",
    "./auth/context": "./src/auth/context.ts",
    "./commands/auth": "./src/commands/auth.ts",
    "./commands/desk-serve": "./src/commands/desk-serve.ts",
    "./commands/repo": "./src/commands/repo.ts",
    "./commands/setup": "./src/commands/setup.ts",
    "./io": "./src/io.ts",
    "./peer/machine": "./src/peer/checks/machine.ts",
    "./setup/accounts": "./src/setup/accounts.ts",
    "./setup/broker": "./src/setup/broker.ts",
    "./setup/cmux": "./src/setup/cmux.ts",
    "./setup/journal": "./src/setup/journal.ts",
    "./setup/launchd": "./src/setup/launchd.ts",
    "./setup/service-path": "./src/setup/service-path.ts",
    "./setup/services": "./src/setup/services.ts",
    "./setup/step": "./src/setup/step.ts",
    "./test/fake-dynsec": "./test/helpers/fake-dynsec.ts",
    "./test/vm-stat": "./test/fixtures/vm-stat.ts"
