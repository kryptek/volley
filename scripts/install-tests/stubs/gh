#!/bin/bash
# gh in vm.test.ts (scripts/install-tests/README.md): every call appended to
# $STUB_STATE/calls.log. It answers verify.sh only: `auth status` exits 1 when
# $STUB_STATE/gh-signed-out exists; `run list` prints the next of $STUB_STATE/gh-run-list.<n>
# (1, 2, …; the last one again once they run out), `run view` the next of gh-run-view.<n> the same
# way; `run watch` exits 0; `run download <id> --dir <dir>` copies $STUB_STATE/artifacts/* into
# <dir>.
set -u
S=${STUB_STATE:?STUB_STATE is not set}
printf 'gh %s\n' "$*" >>"$S/calls.log"
# The next of $S/<name>.<n>, counting calls in $S/<name>.count.
next() {
  local n
  n=$(($(cat "$S/$1.count" 2>/dev/null || echo 0) + 1))
  [ -f "$S/$1.$n" ] && echo "$n" >"$S/$1.count" || n=$(cat "$S/$1.count" 2>/dev/null || echo 1)
  cat "$S/$1.$n" 2>/dev/null
}
case "${1:-} ${2:-}" in
  "auth status") [ ! -e "$S/gh-signed-out" ] || exit 1 ;;
  "run list") next gh-run-list ;;
  "run view") next gh-run-view ;;
  "run download")
    dir=''
    while [ $# -gt 0 ]; do
      case $1 in
        --dir | -D) dir=$2 && shift 2 ;;
        *) shift ;;
      esac
    done
    [ -n "$dir" ] && [ -d "$S/artifacts" ] && cp -R "$S/artifacts/." "$dir/"
    ;;
esac
exit 0
