{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.systems/schemas/0.1/auth-request.schema.json",
  "title": "Volley Account / Token Request",
  "description": "A request on volley/_system/auth/ops/<username> (account, setup, peer_doctor and archive ops, admin accounts only) or volley-auth/redeem/<token_id> (token_redeem, published by that token's own login). The supervisor answers on volley/_system/auth/replies/<correlation_id> with an ack whose secret, if any, is sealed to reply_key. See spec section 4.6.10.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": ["channel", "type", "payload", "correlation_id"],
      "properties": {
        "channel": {
          "const": "_system/auth"
        },
        "type": {
          "const": "query"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "payload": {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": {
              "enum": [
                "account_list",
                "account_create",
                "account_rotate",
                "account_revoke",
                "signin_link",
                "token_redeem",
                "setup_plan",
                "setup_apply",
                "admin_token",
                "desk_password",
                "peer_doctor",
                "archive"
              ]
            },
            "wave": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
              "description": "archive: the ended wave an admin archives (spec section 4.6.16)."
            },
            "dry_run": {
              "type": "boolean",
              "description": "archive: true answers what would be closed and changes nothing."
            },
            "fix": {
              "type": "boolean",
              "description": "peer_doctor: run the doctor with `--fix --yes` (default false: a report and its plan only)."
            },
            "clone": {
              "type": "boolean",
              "description": "peer_doctor: with fix, also `--clone --origin <the running wave's origin>` (clone the wave repo where the host's clone is missing). Needs fix: true; refused while the wave repo's origin is not known."
            },
            "step": {
              "enum": ["detect", "security", "accounts", "services", "phone"],
              "description": "setup_apply: the `volley setup` step to apply."
            },
            "lan": {
              "type": "boolean",
              "description": "setup_plan / setup_apply: whether devices on the LAN may reach the broker's WebSocket listener, as `volley setup --lan` / `--no-lan`; omitted, the security step keeps what the broker config has."
            },
            "repair": {
              "type": "boolean",
              "description": "setup_plan / setup_apply: `volley setup --repair` (re-check and fix only: no new admin token, no phone link)."
            },
            "plan_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "description": "setup_apply: the step's plan_id from the setup_plan answer the person saw; the supervisor refuses with `plan changed` when the step's fresh plan has another."
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
            },
            "role": {
              "enum": ["admin", "steer", "watch", "supervisor", "peer"]
            },
            "kind": {
              "enum": ["human", "device", "machine", "service"]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001f\\u007f-][^\\u0000-\\u001f\\u007f]*$"
            },
            "ttl_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "desk_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^#]*$"
            },
            "token": {
              "type": "string",
              "pattern": "^vly_(admin|signin)_[0-9a-f]{8}_[0-9a-f]{32}$"
            },
            "reply_key": {
              "$ref": "#/$defs/reply_key"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "account_create"
                  }
                }
              },
              "then": {
                "required": ["op", "name", "role", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "account_rotate"
                  }
                }
              },
              "then": {
                "required": ["op", "name", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "account_revoke"
                  }
                }
              },
              "then": {
                "required": ["op", "name"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "signin_link"
                  }
                }
              },
              "then": {
                "required": ["op", "role", "label", "reply_key"],
                "properties": {
                  "role": {
                    "enum": ["steer", "watch"]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "token_redeem"
                  }
                }
              },
              "then": {
                "required": ["op", "token", "label", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "setup_apply"
                  }
                }
              },
              "then": {
                "required": ["op", "step", "plan_id", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "admin_token"
                  }
                }
              },
              "then": {
                "required": ["op", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "desk_password"
                  }
                }
              },
              "then": {
                "required": ["op", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "peer_doctor"
                  }
                }
              },
              "then": {
                "required": ["op", "name"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "archive"
                  }
                }
              },
              "then": {
                "required": ["op", "wave"],
                "properties": {}
              }
            },
            {
              "if": {
                "required": ["clone"],
                "properties": {
                  "clone": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": ["fix"],
                "properties": {
                  "fix": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "reply_key": {
      "type": "object",
      "required": ["kty", "n", "e"],
      "properties": {
        "kty": {
          "const": "RSA"
        },
        "n": {
          "type": "string",
          "minLength": 342,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "e": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "description": "An RSA public key (JWK, at least 2048 bits) the secret in the answer is sealed to with RSA-OAEP / SHA-256."
    }
  }
}
