{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.systems/schemas/0.1/auth-request.schema.json",
  "title": "Volley Account / Token Request",
  "description": "A request on volley/_system/auth/ops/<username> (account, setup, pairing, repository, machine-role and archive ops from admin accounts; inbox_answer and resolve from a Desk login, the owner answering a Needs-you item from any screen, spec section 4.6.18) or volley-auth/redeem/<token_id> (token_redeem, published by that token's own login). The supervisor answers on volley/_system/auth/replies/<correlation_id> with an ack whose secret, if any, is sealed to reply_key; machine_add publishes progress envelopes (one per step and line) on that topic before its ack. See spec section 4.6.10.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": ["channel", "type", "payload", "correlation_id"],
      "properties": {
        "channel": {
          "const": "_system/auth"
        },
        "type": {
          "const": "query"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "payload": {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": {
              "enum": [
                "account_list",
                "account_create",
                "account_rotate",
                "account_revoke",
                "signin_link",
                "token_redeem",
                "setup_plan",
                "setup_apply",
                "admin_token",
                "desk_password",
                "peer_invite",
                "peer_remove",
                "peer_doctor",
                "peer_retarget",
                "machine_add",
                "repo_add",
                "repo_remove",
                "repo_list",
                "repo_status",
                "repo_probe",
                "role_plan",
                "role_move",
                "role_rollback",
                "archive",
                "inbox_answer",
                "resolve",
                "hold",
                "release"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "inbox_answer: the Needs-you item answered (volley/_inbox/<id>)."
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "description": "inbox_answer: the item's version the answer was given at; the supervisor refuses a stale one."
            },
            "answer": {
              "type": "string",
              "minLength": 1,
              "description": "inbox_answer / resolve: the answer."
            },
            "where": {
              "anyOf": [
                { "$ref": "inbox-item.schema.json#/$defs/where" },
                { "type": "string", "minLength": 1 }
              ],
              "description": "inbox_answer / resolve: where the answer was given (a Desk login: kind desk). resolve also takes the label form (`desk·phone`, `mbp·terminal`, `cli`); inbox_answer takes the object only."
            },
            "decision_id": {
              "type": "string",
              "minLength": 1,
              "description": "resolve: the decision resolved; hold / release: the decision held or released (or item)."
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "description": "hold / release: the decision's Needs-you item id instead of decision_id (spec section 4.6.2)."
            },
            "on": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "description": "hold: what the decision waits on (spec section 4.6.2).",
              "properties": {
                "task": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" },
                "pr": { "type": "integer", "minimum": 1 },
                "issue": { "type": "integer", "minimum": 1 }
              }
            },
            "note": {
              "type": "string",
              "description": "hold: why, kept with the hold."
            },
            "rationale": {
              "type": "string",
              "description": "resolve: why, journaled with the answer."
            },
            "wave": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
              "description": "archive: the ended wave an admin archives (spec section 4.6.20); resolve: the decision's wave (optional, found when omitted)."
            },
            "dry_run": {
              "type": "boolean",
              "description": "archive: true answers what would be closed and changes nothing."
            },
            "fix": {
              "type": "boolean",
              "description": "peer_doctor: run the doctor with `--fix --yes` (default false: a report and its plan only)."
            },
            "clone": {
              "type": "boolean",
              "description": "peer_doctor: with fix, also `--clone --origin <the running wave's origin>` (clone the wave repo where the host's clone is missing). Needs fix: true; refused while the wave repo's origin is not known."
            },
            "repos_add": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}(=/[^\\n\\r]*)?$"
              },
              "description": "peer_doctor: `--repo-add` each `<owner/name>` or `<owner/name>=<absolute path>` (an adopted clone) to the machine's peer.json; with fix and clone, each one without a clone is cloned from its GitHub URL (spec section 4.6.21). Excludes repos_remove."
            },
            "repos_remove": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "$ref": "#/$defs/slug" },
              "description": "peer_doctor: `--repo-remove` each `<owner/name>` from the machine's peer.json (its clone is kept). Excludes repos_add."
            },
            "slug": {
              "$ref": "#/$defs/slug",
              "description": "repo_add / repo_remove / repo_status: the repository's GitHub owner/name (spec section 4.6.21)."
            },
            "machines": {
              "oneOf": [
                { "const": "all" },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$" }
                }
              ],
              "description": "repo_add / repo_remove: the machines (configured hosts or the supervisor's own name), or all (the default)."
            },
            "paths": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$" },
              "additionalProperties": {
                "type": "string",
                "maxLength": 1024,
                "pattern": "^/[^\\n\\r]*$"
              },
              "description": "repo_add: a paired machine's existing clone to adopt (hosts.<machine>.repos), by machine name; absolute paths there."
            },
            "machine": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$",
              "description": "repo_probe: the paired machine (a configured host, never the supervisor's own) whose path is read (spec section 4.6.21)."
            },
            "path": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^/[^\\n\\r]*$",
              "description": "repo_probe: the adopted-clone path read on the machine, as repo_add's paths take it (absolute, no `..` segment, no control character)."
            },
            "step": {
              "enum": ["detect", "security", "accounts", "services", "phone"],
              "description": "setup_apply: the `volley setup` step to apply."
            },
            "lan": {
              "type": "boolean",
              "description": "setup_plan / setup_apply: whether devices on the LAN may reach the broker's WebSocket listener, as `volley setup --lan` / `--no-lan`; omitted, the security step keeps what the broker config has."
            },
            "repair": {
              "type": "boolean",
              "description": "setup_plan / setup_apply: `volley setup --repair` (re-check and fix only: no new admin token, no phone link)."
            },
            "plan_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "description": "setup_apply / role_move: the plan_id from the setup_plan / role_plan answer the person saw; the supervisor refuses with `plan changed` when the fresh plan has another."
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
            },
            "role": {
              "enum": ["admin", "steer", "watch", "supervisor", "peer", "broker", "desk"],
              "description": "account_create / signin_link: the account role (admin, steer, watch, supervisor, peer); role_plan / role_move: the machine role moved (broker, supervisor, desk; spec section 4.6.24)."
            },
            "to": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
              "description": "role_plan / role_move: the machine the role moves to (a configured host or the supervisor's own name)."
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^-\\s][^\\s]*$",
              "description": "role_plan / role_move (broker): the ssh destination every machine's tunnel reaches the broker at (default: the target's hosts.<name>.target); peer_retarget: the ssh destination the machine's tunnel reaches the broker's machine at from now on; machine_add: the bare box's ssh destination, user@host (spec section 4.6.14)."
            },
            "auth": {
              "type": "object",
              "description": "machine_add: how the supervisor's first ssh to the box signs in, to install its own key there: key, an absolute path to a key file on the supervisor's machine, or password_ref, the box's password (read only by the supervisor, through an SSH_ASKPASS helper reading a 0600 temp file removed after that step; never journaled, logged or answered).",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "key": { "type": "string", "pattern": "^/[^\\n\\u0000]*$" },
                "password_ref": { "type": "string", "minLength": 1 }
              }
            },
            "sudo_ref": {
              "type": "string",
              "minLength": 1,
              "description": "machine_add: the box's sudo password, used only when it lacks what only sudo installs (git, tmux, curl, gh on Linux), through a SUDO_ASKPASS helper on the box reading a 0600 file removed when that step ends; never journaled, logged or answered."
            },
            "terminal": {
              "enum": ["cmux", "tmux"],
              "description": "role_plan / role_move (supervisor): the terminal the old machine re-pairs with."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "role_plan / role_move (desk): the port the Desk serves on at its new machine (default 5199); peer_retarget: the machine's tunnel port on its loopback (1024..65535; default: the one it has, or with tunnel none the broker's port)."
            },
            "tunnel": {
              "enum": ["ssh", "none"],
              "description": "peer_retarget: ssh (the machine keeps its own tunnel to address) or none (the broker runs on that machine itself; spec section 4.6.14)."
            },
            "drain": {
              "type": "boolean",
              "description": "role_move: wait for the fleet to be quiet instead of being refused (spec section 4.6.24); peer_remove: remove the machine once no agent runs there (spec section 4.6.14)."
            },
            "now": {
              "type": "boolean",
              "description": "peer_remove: stop the machine's agents and remove it (spec section 4.6.14). Excludes drain."
            },
            "for": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
              "description": "peer_invite: the one machine name the code joins as: a paired machine it re-pairs, or a new one (spec section 4.6.14)."
            },
            "move_id": {
              "$ref": "role-move.schema.json#/$defs/move_id",
              "description": "role_rollback: the move undone."
            },
            "kind": {
              "enum": ["human", "device", "machine", "service"]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001f\\u007f-][^\\u0000-\\u001f\\u007f]*$"
            },
            "ttl_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "desk_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^#]*$"
            },
            "token": {
              "type": "string",
              "pattern": "^vly_(admin|signin)_[0-9a-f]{8}_[0-9a-f]{32}$"
            },
            "reply_key": {
              "$ref": "#/$defs/reply_key"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "account_create"
                  }
                }
              },
              "then": {
                "required": ["op", "name", "role", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": { "properties": { "op": { "enum": ["account_create", "signin_link"] } } },
              "then": {
                "properties": {
                  "role": { "enum": ["admin", "steer", "watch", "supervisor", "peer"] }
                }
              }
            },
            {
              "if": { "properties": { "op": { "const": "peer_invite" } } },
              "then": { "required": ["op", "reply_key"] }
            },
            {
              "if": { "properties": { "op": { "const": "peer_remove" } } },
              "then": {
                "required": ["op", "name"],
                "not": {
                  "properties": { "drain": { "const": true }, "now": { "const": true } },
                  "required": ["drain", "now"]
                }
              }
            },
            {
              "if": { "properties": { "op": { "const": "peer_retarget" } } },
              "then": {
                "required": ["op", "name", "address"],
                "properties": { "port": { "minimum": 1024 } }
              }
            },
            {
              "if": { "properties": { "op": { "const": "machine_add" } } },
              "then": { "required": ["op", "address", "auth"] }
            },
            {
              "if": { "properties": { "op": { "const": "role_plan" } } },
              "then": {
                "required": ["op", "role", "to"],
                "properties": { "role": { "enum": ["broker", "supervisor", "desk"] } }
              }
            },
            {
              "if": { "properties": { "op": { "const": "role_move" } } },
              "then": {
                "required": ["op", "role", "to", "plan_id", "reply_key"],
                "properties": { "role": { "enum": ["broker", "supervisor", "desk"] } }
              }
            },
            {
              "if": { "properties": { "op": { "const": "role_rollback" } } },
              "then": { "required": ["op", "move_id"] }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "account_rotate"
                  }
                }
              },
              "then": {
                "required": ["op", "name", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "account_revoke"
                  }
                }
              },
              "then": {
                "required": ["op", "name"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "signin_link"
                  }
                }
              },
              "then": {
                "required": ["op", "role", "label", "reply_key"],
                "properties": {
                  "role": {
                    "enum": ["steer", "watch"]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "token_redeem"
                  }
                }
              },
              "then": {
                "required": ["op", "token", "label", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "setup_apply"
                  }
                }
              },
              "then": {
                "required": ["op", "step", "plan_id", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "admin_token"
                  }
                }
              },
              "then": {
                "required": ["op", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "desk_password"
                  }
                }
              },
              "then": {
                "required": ["op", "reply_key"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "peer_doctor"
                  }
                }
              },
              "then": {
                "required": ["op", "name"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "enum": ["repo_add", "repo_remove"]
                  }
                }
              },
              "then": {
                "required": ["op", "slug"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "repo_probe"
                  }
                }
              },
              "then": {
                "required": ["op", "machine", "path"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "archive"
                  }
                }
              },
              "then": {
                "required": ["op", "wave"],
                "properties": {}
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "inbox_answer"
                  }
                }
              },
              "then": {
                "required": ["op", "id", "version", "answer", "where"],
                "properties": {
                  "where": {
                    "type": "object"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "resolve"
                  }
                }
              },
              "then": {
                "required": ["op", "decision_id", "answer"],
                "properties": {}
              }
            },
            {
              "if": { "properties": { "op": { "const": "hold" } } },
              "then": {
                "required": ["op", "on"],
                "anyOf": [{ "required": ["decision_id"] }, { "required": ["item"] }]
              }
            },
            {
              "if": { "properties": { "op": { "const": "release" } } },
              "then": { "anyOf": [{ "required": ["decision_id"] }, { "required": ["item"] }] }
            },
            {
              "if": {
                "required": ["clone"],
                "properties": {
                  "clone": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": ["fix"],
                "properties": {
                  "fix": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/(?!\\.\\.?$)(?![A-Za-z0-9_.-]*\\.git$)[A-Za-z0-9_.-]{1,100}$"
    },
    "reply_key": {
      "type": "object",
      "required": ["kty", "n", "e"],
      "properties": {
        "kty": {
          "const": "RSA"
        },
        "n": {
          "type": "string",
          "minLength": 342,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "e": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "description": "An RSA public key (JWK, at least 2048 bits) the secret in the answer is sealed to with RSA-OAEP / SHA-256."
    }
  }
}
