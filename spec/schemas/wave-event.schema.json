{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.systems/schemas/0.1/wave-event.schema.json",
  "title": "Volley Wave Event",
  "description": "Non-retained live mirror of one supervisor journal event, published to volley/_waves/<wave>/events. The envelope type is the journal event type. Event data is free-form except for the event types constrained below. See spec sections 4.6.3, 4.6.15 and 4.6.16.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "channel": { "const": "_waves/events" },
        "type": {
          "enum": [
            "wave_submitted",
            "wave_versioned",
            "wave_paused",
            "wave_resumed",
            "wave_stopped",
            "wave_complete",
            "wave_archived",
            "owner_claimed",
            "owner_reconnected",
            "task_queued",
            "task_admitted",
            "task_cancelled",
            "agent_spawned",
            "agent_registered",
            "agent_retired",
            "agent_session_closed",
            "spawn_failed",
            "spawn_recovered",
            "spawn_adopted",
            "launch_orphan_closed",
            "spawn_identity_burned",
            "verify_failed",
            "stage_entered",
            "artifact_verified",
            "steering_sent",
            "steering_queued",
            "steering_dropped",
            "steering_received",
            "agent_woken",
            "decision_opened",
            "decision_resolved",
            "lease_requested",
            "lease_granted",
            "lease_released",
            "lease_expired",
            "alarm_raised",
            "wake_detected",
            "reap_suppressed",
            "reconciled",
            "config_changed",
            "account_created",
            "account_rotated",
            "account_revoked",
            "signin_link_issued",
            "token_redeemed",
            "setup_step_applied",
            "admin_token_issued",
            "desk_password_issued",
            "claude_account_added",
            "claude_signin_started",
            "claude_signin_done",
            "claude_signin_failed",
            "claude_profile_synced",
            "agent_account_moved",
            "account_chosen",
            "relaunched",
            "ci_pending",
            "ci_green",
            "pr_head_moved",
            "merged_by_operator",
            "pr_conflicting",
            "merged_by_supervisor",
            "merge_queued",
            "merge_dequeued",
            "merge_started",
            "merge_ended",
            "agent_force_retired",
            "alarm_cleared",
            "wave_account_moved",
            "agent_reaped_by_supervisor",
            "credentials_revoked",
            "credentials_swept",
            "peer_invited",
            "peer_joined",
            "peer_removed",
            "task_placed",
            "machine_readiness_changed",
            "merge_nudge_sent",
            "peer_doctor_run",
            "peer_drain_started",
            "repo_visibility_detected",
            "decision_auto_resolved",
            "decision_escalated",
            "decision_held",
            "decision_released",
            "release_started",
            "release_stage_entered",
            "release_stage_verified",
            "release_stage_failed",
            "release_stage_skipped",
            "release_cancelled",
            "release_done",
            "inbox_opened",
            "inbox_answered",
            "remediation_requested",
            "remediation_closed",
            "digest_published",
            "pr_marked_ready"
          ]
        },
        "payload": {
          "type": "object",
          "required": ["wave", "seq", "at"],
          "properties": {
            "wave": {
              "type": "string",
              "oneOf": [{ "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" }, { "const": "_system" }],
              "description": "Wave id, or the pseudo-wave _system for global events."
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "description": "Journal sequence number, monotonic per wave."
            },
            "at": { "type": "string", "format": "date-time" },
            "task": {
              "type": "string",
              "pattern": "^([A-Za-z0-9][A-Za-z0-9_-]{0,62}|_release)$",
              "description": "A wave-file task id, or _release: the release train's pseudo task (spec section 4.6.19)."
            },
            "data": { "type": "object", "description": "Event-type-specific detail." }
          }
        }
      },
      "required": ["channel", "type", "payload"]
    },
    {
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "account_chosen" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "description": "The Claude account a spawn runs under and why (spec section 4.6.11), journaled right before its agent_spawned. Names no e-mail.",
                    "required": [
                      "task",
                      "role",
                      "attempt",
                      "account",
                      "machine",
                      "source",
                      "why",
                      "candidates"
                    ],
                    "properties": {
                      "task": {
                        "type": "string",
                        "pattern": "^([A-Za-z0-9][A-Za-z0-9_-]{0,62}|_release)$"
                      },
                      "role": { "type": "string", "minLength": 1 },
                      "attempt": { "type": "integer", "minimum": 1 },
                      "account": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}(@[a-z0-9][a-z0-9_.-]{0,62})?$"
                      },
                      "machine": { "$ref": "wave-state.schema.json#/$defs/hostName" },
                      "source": {
                        "enum": ["task", "wave", "config", "balance", "move", "default"]
                      },
                      "why": { "type": "string", "minLength": 1 },
                      "candidates": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "account",
                            "five_hour_pct",
                            "weekly_pct",
                            "agents",
                            "headroom"
                          ],
                          "properties": {
                            "account": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}(@[a-z0-9][a-z0-9_.-]{0,62})?$"
                            },
                            "five_hour_pct": {
                              "oneOf": [
                                { "type": "number", "minimum": 0, "maximum": 100 },
                                { "type": "null" }
                              ]
                            },
                            "weekly_pct": {
                              "oneOf": [
                                { "type": "number", "minimum": 0, "maximum": 100 },
                                { "type": "null" }
                              ]
                            },
                            "model_weekly_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                            "agents": { "type": "integer", "minimum": 0 },
                            "headroom": {
                              "oneOf": [
                                { "type": "number", "minimum": 0, "maximum": 100 },
                                { "type": "null" }
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "agent_account_moved" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "decision_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
                        "description": "The agent_account_limit decision whose answer moved it (absent: an agent_move_account request)."
                      },
                      "why": {
                        "type": "string",
                        "minLength": 1,
                        "description": "That decision's one-line reason."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "task_placed" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["task", "host", "score", "candidates", "by"],
                    "properties": {
                      "task": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" },
                      "host": { "$ref": "wave-state.schema.json#/$defs/hostName" },
                      "score": {
                        "$ref": "wave-state.schema.json#/$defs/placement/properties/score"
                      },
                      "candidates": {
                        "$ref": "wave-state.schema.json#/$defs/placement/properties/candidates"
                      },
                      "by": { "$ref": "wave-state.schema.json#/$defs/placement/properties/by" },
                      "from": {
                        "$ref": "wave-state.schema.json#/$defs/hostName",
                        "description": "The host the task was placed on before, when it is re-placed."
                      },
                      "local": {
                        "const": true,
                        "description": "The supervisor's own machine (its agents' tasks[].host stays absent); absent for a peer."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "machine_readiness_changed" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["name", "ready", "reasons"],
                    "properties": {
                      "name": {
                        "$ref": "readiness.schema.json#/allOf/1/properties/payload/properties/name"
                      },
                      "ready": { "type": "boolean" },
                      "reasons": {
                        "$ref": "readiness.schema.json#/allOf/1/properties/payload/properties/reasons"
                      }
                    }
                  },
                  "wave": { "const": "_system" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "owner_reconnected" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["owner", "agent_id", "previous_agent_id"],
                    "properties": {
                      "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "agent_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "previous_agent_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "wave_archived" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["by", "reason", "closed_decisions"],
                    "properties": {
                      "by": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Who archived the wave: the owner or caller, an admin, or the supervisor (auto-archive)."
                      },
                      "reason": { "type": "string" },
                      "closed_decisions": {
                        "type": "array",
                        "items": { "$ref": "wave-state.schema.json#/$defs/decisionId" },
                        "description": "The decisions the archive closed with answer archived (each journaled before as decision_resolved)."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "merge_nudge_sent" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["task", "agent_id", "merged_pr", "files"],
                    "properties": {
                      "task": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" },
                      "agent_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "merged_pr": { "type": "integer", "minimum": 1 },
                      "files": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 },
                        "description": "The merged PR's files that overlap the task's; empty under nudge_on_merge: all."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "decision_auto_resolved" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "decision_id",
                      "kind",
                      "policy",
                      "answer",
                      "rationale",
                      "evidence"
                    ],
                    "properties": {
                      "decision_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "kind": { "type": "string", "minLength": 1 },
                      "policy": { "type": "string", "minLength": 1 },
                      "answer": { "type": "string", "minLength": 1 },
                      "rationale": { "type": "string" },
                      "evidence": { "type": "object" },
                      "budget": {
                        "type": "object",
                        "required": ["key", "used", "max"],
                        "properties": {
                          "key": { "type": "string", "minLength": 1 },
                          "used": { "type": "number", "minimum": 0 },
                          "max": { "type": "number", "minimum": 0 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "decision_held"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["decision_id", "kind", "on", "by"],
                    "properties": {
                      "decision_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                      },
                      "kind": {
                        "type": "string",
                        "minLength": 1
                      },
                      "on": {
                        "type": "object",
                        "additionalProperties": false,
                        "minProperties": 1,
                        "description": "What it waits on: a task of the wave, a PR, an issue (one or more).",
                        "properties": {
                          "task": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$"
                          },
                          "pr": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "issue": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      },
                      "note": {
                        "type": "string"
                      },
                      "by": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "decision_released"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["decision_id", "kind", "why", "by"],
                    "properties": {
                      "decision_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                      },
                      "kind": {
                        "type": "string",
                        "minLength": 1
                      },
                      "why": {
                        "type": "string",
                        "minLength": 1
                      },
                      "by": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "decision_escalated" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["decision_id", "kind", "why"],
                    "properties": {
                      "decision_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "kind": { "type": "string", "minLength": 1 },
                      "why": {
                        "enum": ["owner_only", "no_policy", "budget_exhausted", "unattended_safety"]
                      },
                      "budget": {
                        "type": "object",
                        "required": ["key", "used", "max"],
                        "properties": {
                          "key": { "type": "string", "minLength": 1 },
                          "used": { "type": "number", "minimum": 0 },
                          "max": { "type": "number", "minimum": 0 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "inbox_answered" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["id", "kind", "answer", "by", "where", "version"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[dphr]-[A-Za-z0-9_-]{1,200}$" },
                      "kind": { "enum": ["decision", "picker", "handoff", "release"] },
                      "answer": { "type": "string", "minLength": 1 },
                      "by": { "type": "string", "minLength": 1 },
                      "where": { "$ref": "inbox-item.schema.json#/$defs/where" },
                      "version": { "type": "integer", "minimum": 2 }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pr_conflicting" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["pr", "head", "release_branch"],
                    "properties": {
                      "pr": {
                        "type": "object",
                        "required": ["number", "url"],
                        "properties": {
                          "number": { "type": "integer", "minimum": 1 },
                          "url": { "type": "string" }
                        }
                      },
                      "head": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{7,64}$",
                        "description": "The PR head GitHub reports CONFLICTING, where the branch-update step starts."
                      },
                      "release_branch": { "type": "string", "minLength": 1 },
                      "role": {
                        "type": "string",
                        "description": "The role whose pushed head it is (implementer, fixup)."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "remediation_requested" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["kind", "test", "test_file", "head", "run_urls", "for"],
                    "properties": {
                      "kind": {
                        "enum": ["fix_flake"],
                        "description": "fix_flake: a red head's failing test the PR does not touch (spec section 4.6.16); a dedicated fixer is requested, never a re-run."
                      },
                      "test": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The failing test id the fixer is for (its dedupe key)."
                      },
                      "test_file": {
                        "type": ["string", "null"],
                        "description": "The test's file, null when its id names none."
                      },
                      "tests": { "type": "array", "items": { "type": "string" } },
                      "head": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
                      "run_urls": { "type": "array", "items": { "type": "string" } },
                      "for": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$",
                        "description": "The task whose red head it is."
                      },
                      "role": { "type": "string" },
                      "release_ci": { "enum": ["green", "red", "running", "none", "unknown"] }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "task_queued" },
              "payload": {
                "properties": { "data": { "required": ["synthetic"] } },
                "required": ["data"]
              }
            },
            "required": ["type", "payload"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "task": {
                    "type": "string",
                    "pattern": "^fix-[a-z0-9-]{1,50}$",
                    "description": "A flake's fixer: fix-<slug of its test> (spec section 4.6.16)."
                  },
                  "data": {
                    "type": "object",
                    "required": ["issue", "synthetic", "title", "remediation"],
                    "description": "A synthetic task (spec section 4.6.16): added by the supervisor, never by a wave file; issue 0, the wave's pipeline, no after.",
                    "properties": {
                      "issue": { "const": 0 },
                      "synthetic": { "const": true },
                      "title": { "type": "string", "minLength": 1 },
                      "remediation": { "$ref": "wave-state.schema.json#/$defs/fixerRemediation" }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "remediation_closed" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["kind", "test", "task", "outcome", "released"],
                    "description": "A flake's fixer settled (spec section 4.6.16): landed (done: merged) releases the tasks still parked on its test, which update from the release branch and are verified again; failed (cancelled, blocked, escalated) puts each blocked task's red head back to the owner, escalated unattended_safety.",
                    "properties": {
                      "kind": { "enum": ["fix_flake"] },
                      "test": { "type": "string", "minLength": 1 },
                      "task": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" },
                      "outcome": { "enum": ["landed", "failed"] },
                      "why": { "type": "string", "minLength": 1 },
                      "released": {
                        "type": "array",
                        "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" }
                      }
                    },
                    "if": { "properties": { "outcome": { "const": "failed" } } },
                    "then": { "required": ["why"], "properties": { "released": { "maxItems": 0 } } }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "digest_published" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["trigger"],
                    "description": "The supervisor published the wave's digest on volley/_waves/<wave>/digest and pushed its one-line summary (spec section 4.6.16).",
                    "properties": {
                      "trigger": {
                        "enum": ["wave_complete", "release_go", "escalation", "stopped"]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "ci_pending" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["role", "sha", "checks"],
                    "description": "The supervisor holds the task for CI on sha: its runs completed and all of them (checks), and, when the head's jobs could be read, the same for its jobs with the running and failed job names (jobs) and the estimated seconds left (eta_s, absent without an estimate) (spec section 4.6.8).",
                    "properties": {
                      "role": { "type": "string", "minLength": 1 },
                      "sha": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
                      "checks": {
                        "type": "object",
                        "required": ["done", "total"],
                        "properties": {
                          "done": { "type": "integer", "minimum": 0 },
                          "total": { "type": "integer", "minimum": 0 }
                        }
                      },
                      "jobs": {
                        "type": "object",
                        "required": ["done", "total", "running", "failed"],
                        "properties": {
                          "done": { "type": "integer", "minimum": 0 },
                          "total": { "type": "integer", "minimum": 0 },
                          "running": { "type": "array", "items": { "type": "string" } },
                          "failed": { "type": "array", "items": { "type": "string" } },
                          "last_done_at": { "type": "string", "format": "date-time" },
                          "slowest_s": { "type": "integer", "minimum": 0 }
                        }
                      },
                      "eta_s": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "pr_marked_ready" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["pr", "head", "at"],
                    "description": "The supervisor marked a draft PR ready for review at head (gh pr ready), so the CI its repository skips on drafts runs; the CI gate on that head then counts only runs created at or after at (spec section 4.6.8).",
                    "properties": {
                      "pr": { "type": "integer", "minimum": 1 },
                      "head": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
                      "at": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
