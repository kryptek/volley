{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.systems/schemas/0.1/wave-event.schema.json",
  "title": "Volley Wave Event",
  "description": "Non-retained live mirror of one supervisor journal event, published to volley/_waves/<wave>/events. The envelope type is the journal event type. Event data is free-form except for the event types constrained below. See spec sections 4.6.3 and 4.6.15.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "channel": { "const": "_waves/events" },
        "type": {
          "enum": [
            "wave_submitted",
            "wave_versioned",
            "wave_paused",
            "wave_resumed",
            "wave_stopped",
            "wave_complete",
            "owner_claimed",
            "owner_reconnected",
            "task_queued",
            "task_admitted",
            "task_cancelled",
            "agent_spawned",
            "agent_registered",
            "agent_retired",
            "agent_session_closed",
            "spawn_failed",
            "spawn_recovered",
            "spawn_adopted",
            "launch_orphan_closed",
            "spawn_identity_burned",
            "verify_failed",
            "stage_entered",
            "artifact_verified",
            "steering_sent",
            "steering_queued",
            "steering_dropped",
            "decision_opened",
            "decision_resolved",
            "lease_requested",
            "lease_granted",
            "lease_released",
            "lease_expired",
            "alarm_raised",
            "wake_detected",
            "reap_suppressed",
            "reconciled",
            "config_changed",
            "account_created",
            "account_rotated",
            "account_revoked",
            "signin_link_issued",
            "token_redeemed",
            "setup_step_applied",
            "admin_token_issued",
            "desk_password_issued",
            "claude_account_added",
            "claude_signin_started",
            "claude_signin_done",
            "claude_signin_failed",
            "claude_profile_synced",
            "agent_account_moved",
            "relaunched",
            "ci_pending",
            "ci_green",
            "pr_head_moved",
            "merged_by_operator",
            "merged_by_supervisor",
            "agent_force_retired",
            "alarm_cleared",
            "wave_account_moved",
            "agent_reaped_by_supervisor",
            "credentials_revoked",
            "credentials_swept",
            "peer_invited",
            "peer_joined",
            "peer_removed",
            "task_placed",
            "machine_readiness_changed",
            "merge_nudge_sent",
            "peer_doctor_run",
            "peer_drain_started",
            "repo_visibility_detected",
            "decision_auto_resolved",
            "decision_escalated",
            "release_started",
            "release_stage_entered",
            "release_stage_verified",
            "release_stage_failed",
            "release_done",
            "inbox_opened",
            "inbox_answered"
          ]
        },
        "payload": {
          "type": "object",
          "required": ["wave", "seq", "at"],
          "properties": {
            "wave": {
              "type": "string",
              "oneOf": [{ "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" }, { "const": "_system" }],
              "description": "Wave id, or the pseudo-wave _system for global events."
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "description": "Journal sequence number, monotonic per wave."
            },
            "at": { "type": "string", "format": "date-time" },
            "task": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" },
            "data": { "type": "object", "description": "Event-type-specific detail." }
          }
        }
      },
      "required": ["channel", "type", "payload"]
    },
    {
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "task_placed" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["task", "host", "score", "candidates", "by"],
                    "properties": {
                      "task": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" },
                      "host": { "$ref": "wave-state.schema.json#/$defs/hostName" },
                      "score": {
                        "$ref": "wave-state.schema.json#/$defs/placement/properties/score"
                      },
                      "candidates": {
                        "$ref": "wave-state.schema.json#/$defs/placement/properties/candidates"
                      },
                      "by": { "$ref": "wave-state.schema.json#/$defs/placement/properties/by" },
                      "from": {
                        "$ref": "wave-state.schema.json#/$defs/hostName",
                        "description": "The host the task was placed on before, when it is re-placed."
                      },
                      "local": {
                        "const": true,
                        "description": "The supervisor's own machine (its agents' tasks[].host stays absent); absent for a peer."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "machine_readiness_changed" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["name", "ready", "reasons"],
                    "properties": {
                      "name": {
                        "$ref": "readiness.schema.json#/allOf/1/properties/payload/properties/name"
                      },
                      "ready": { "type": "boolean" },
                      "reasons": {
                        "$ref": "readiness.schema.json#/allOf/1/properties/payload/properties/reasons"
                      }
                    }
                  },
                  "wave": { "const": "_system" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "owner_reconnected" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["owner", "agent_id", "previous_agent_id"],
                    "properties": {
                      "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "agent_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "previous_agent_id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "merge_nudge_sent" } }, "required": ["type"] },
          "then": {
            "properties": {
              "payload": {
                "required": ["task", "data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["task", "agent_id", "merged_pr", "files"],
                    "properties": {
                      "task": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" },
                      "agent_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "merged_pr": { "type": "integer", "minimum": 1 },
                      "files": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 },
                        "description": "The merged PR's files that overlap the task's; empty under nudge_on_merge: all."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "decision_auto_resolved" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "decision_id",
                      "kind",
                      "policy",
                      "answer",
                      "rationale",
                      "evidence"
                    ],
                    "properties": {
                      "decision_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "kind": { "type": "string", "minLength": 1 },
                      "policy": { "type": "string", "minLength": 1 },
                      "answer": { "type": "string", "minLength": 1 },
                      "rationale": { "type": "string" },
                      "evidence": { "type": "object" },
                      "budget": {
                        "type": "object",
                        "required": ["key", "used", "max"],
                        "properties": {
                          "key": { "type": "string", "minLength": 1 },
                          "used": { "type": "number", "minimum": 0 },
                          "max": { "type": "number", "minimum": 0 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "decision_escalated" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["decision_id", "kind", "why"],
                    "properties": {
                      "decision_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
                      "kind": { "type": "string", "minLength": 1 },
                      "why": {
                        "enum": ["owner_only", "no_policy", "budget_exhausted", "unattended_safety"]
                      },
                      "budget": {
                        "type": "object",
                        "required": ["key", "used", "max"],
                        "properties": {
                          "key": { "type": "string", "minLength": 1 },
                          "used": { "type": "number", "minimum": 0 },
                          "max": { "type": "number", "minimum": 0 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "inbox_answered" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "required": ["data"],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": ["id", "kind", "answer", "by", "where", "version"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[dphr]-[A-Za-z0-9_-]{1,200}$" },
                      "kind": { "enum": ["decision", "picker", "handoff", "release"] },
                      "answer": { "type": "string", "minLength": 1 },
                      "by": { "type": "string", "minLength": 1 },
                      "where": { "$ref": "inbox-item.schema.json#/$defs/where" },
                      "version": { "type": "integer", "minimum": 2 }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
