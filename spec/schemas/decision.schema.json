{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.systems/schemas/0.1/decision.schema.json",
  "title": "Volley Wave Decision",
  "description": "A question only a human (or the owning coordinator) can answer, published retained to volley/_waves/<wave>/decisions/<decision_id> while open and cleared with an empty retained payload on resolve. See spec section 4.6.2.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "channel": { "const": "_waves/decisions" },
        "type": { "enum": ["decision_opened", "decision_resolved"] },
        "payload": {
          "type": "object",
          "required": ["decision_id", "wave", "task", "kind", "question", "pointers", "opened_at"],
          "properties": {
            "decision_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
            "wave": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
            "task": {
              "oneOf": [
                { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$" },
                { "type": "null" }
              ],
              "description": "Task id, or null for a wave-level decision (e.g. wave_complete)."
            },
            "kind": {
              "enum": [
                "reviewers_disagree",
                "merge_conflict",
                "agent_blocked",
                "unknown_screen",
                "model_switch",
                "repo_untrusted",
                "remote_repo_missing",
                "ci_failed",
                "wave_complete",
                "plan_change"
              ]
            },
            "question": { "type": "string", "minLength": 1 },
            "options": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "pointers": {
              "type": "object",
              "description": "Where the evidence lives. Paths are on the supervisor's host.",
              "properties": {
                "diff": { "type": "string", "minLength": 1 },
                "transcript": { "type": "string", "minLength": 1 },
                "screen": { "type": "string", "minLength": 1 },
                "pr": { "type": "string", "minLength": 1 }
              }
            },
            "opened_at": { "type": "string", "format": "date-time" },
            "resolved": {
              "type": "object",
              "required": ["answer", "by", "at"],
              "properties": {
                "answer": { "type": "string", "minLength": 1 },
                "by": { "type": "string", "minLength": 1 },
                "at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      },
      "required": ["channel", "type", "payload"],
      "if": { "properties": { "type": { "const": "decision_resolved" } } },
      "then": { "properties": { "payload": { "required": ["resolved"] } } },
      "else": { "properties": { "payload": { "not": { "required": ["resolved"] } } } }
    }
  ]
}
