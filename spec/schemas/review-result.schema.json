{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.systems/schemas/0.1/review-result.schema.json",
  "title": "Volley Pipeline Result",
  "description": "The retained result a supervised pipeline role publishes before its done status: a reviewer's findings (type review), a fix-up's resolutions (type fixup) or a release stage's report (type stage, spec section 4.6.19). See spec section 4.6.8.",
  "allOf": [
    { "$ref": "result.schema.json" },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "review" },
            "payload": { "$ref": "#/$defs/review" }
          },
          "required": ["type", "payload"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "fixup" },
            "payload": { "$ref": "#/$defs/fixup" }
          },
          "required": ["type", "payload"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "stage" },
            "payload": { "$ref": "#/$defs/stage" }
          },
          "required": ["type", "payload"]
        }
      ]
    }
  ],
  "$defs": {
    "stage": {
      "type": "object",
      "description": "A release stage agent's report (spec section 4.6.19): the stage it ran, every command with its exit code and wall seconds, in the order run, and what it produced.",
      "required": ["stage", "commands"],
      "properties": {
        "stage": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["argv", "code", "seconds"],
            "properties": {
              "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "code": { "type": "integer" },
              "seconds": { "type": "number", "minimum": 0 }
            }
          }
        },
        "notes": { "type": "string" },
        "artifacts": {
          "type": "object",
          "properties": {
            "tag": { "type": "string", "minLength": 1 },
            "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "urls": { "type": "array", "items": { "type": "string", "format": "uri" } }
          }
        }
      }
    },
    "severity": {
      "enum": ["P1", "P2", "P3"],
      "description": "P1 blocks the merge; P2 should be fixed; P3 is a nit."
    },
    "finding": {
      "type": "object",
      "required": ["severity", "file", "text"],
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "file": { "type": "string", "minLength": 1, "description": "Repo-relative path." },
        "line": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "required": ["findings", "verdict"],
      "properties": {
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "verdict": { "enum": ["approve", "changes_requested"] },
        "hygiene": { "$ref": "#/$defs/hygiene" },
        "summary": { "type": "string" }
      }
    },
    "hygiene": {
      "type": "object",
      "description": "The reviewer's public-hygiene check of the diff, commit messages and PR text: person names, local usernames, machine paths, private hostnames or IPs (spec section 4.6.8). Optional in the schema: a supervisor whose public_hygiene setting resolves to public (a public repository, or one whose visibility it could not read) requires it, treats a review without checked: true as no review result and counts every finding as a P1; for a private repository it may accept a review without it and count its findings as P3s, or ignore it.",
      "required": ["checked", "findings"],
      "properties": {
        "checked": { "const": true },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "fixup": {
      "type": "object",
      "required": ["resolved"],
      "properties": {
        "resolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding", "how"],
            "properties": {
              "finding": {
                "type": "string",
                "minLength": 1,
                "description": "The finding as listed in .volley/findings.md (its id, e.g. S1 or Q2)."
              },
              "how": { "type": "string", "minLength": 1 }
            }
          }
        },
        "summary": { "type": "string" }
      }
    }
  }
}
