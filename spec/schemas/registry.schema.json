{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.systems/schemas/0.1/registry.schema.json",
  "title": "Volley Registry Entry",
  "description": "Retained registry entry published to volley/_system/registry/<agent_id>. See spec section 6.",
  "$defs": {
    "ref": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "format": "uri", "pattern": "^https?://" }
      ]
    }
  },
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "channel": { "const": "_system/registry" },
        "type": { "const": "registered" },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
        },
        "payload": {
          "type": "object",
          "required": ["capabilities", "started_at"],
          "properties": {
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string" },
            "model": { "type": "string" },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^\\r\\n]*$",
              "description": "One line saying what the agent is working on (spec section 6.2)."
            },
            "links": {
              "type": "object",
              "additionalProperties": false,
              "description": "References for the agent's purpose (spec section 6.2): a number is an issue or PR in `repo`.",
              "properties": {
                "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
                "issue": { "$ref": "#/$defs/ref" },
                "pr": { "$ref": "#/$defs/ref" }
              }
            },
            "workspace_title": {
              "type": "string",
              "description": "A coordinator session's terminal workspace title, from its harness hooks (spec section 4.3)."
            },
            "claude_account": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
              "description": "The Claude account profile the agent runs under (spec section 4.6.11), from its assigned identity."
            },
            "coordinator": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
              "description": "The stable coordinator name the session acts as (spec section 6.2, VOLLEY_COORDINATOR): a wave owned by this name follows the newest live session carrying it."
            },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "description": "The publisher's process id (spec section 6.2)."
            },
            "surface": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "The terminal pane the session runs in (spec section 6.2), e.g. cmux's CMUX_SURFACE_ID: hooks sharing a cwd match their own entry on it."
            },
            "started_at": { "type": "string", "format": "date-time" }
          }
        }
      },
      "required": ["channel", "type", "namespace", "payload"]
    }
  ]
}
