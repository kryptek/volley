{
  "name": "volley",
  "private": true,
  "version": "0.10.0",
  "description": "Volley — agent messaging standard",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "lint": "biome check . && shellcheck install.sh",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --filter='*' typecheck",
    "test": "bun scripts/check-tmp-leaks.ts -- bun run test:suites",
    "test:suites": "bun run test:scripts && bun run --filter='*' test",
    "test:scripts": "bun test ./scripts",
    "validate:schemas": "bun run scripts/validate-schemas.ts",
    "check:spec-refs": "bun run scripts/check-spec-refs.ts",
    "changelog": "bun scripts/changelog.ts",
    "sounds:generate": "bun scripts/sounds/generate.ts",
    "sounds:pick": "bun scripts/sounds/pick.ts",
    "sounds:check": "bun scripts/sounds/check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "bun-types": "^1.1.0",
    "typescript": "^5.6.0",
    "volley-cli": "workspace:*",
    "volley-desk": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3 <1.5"
  }
}
